RABBITMQ_URL=amqp://localhost

WHATSAPP_AUTH_DIR=auth_info_baileys
WHATSAPP_WEB_VERSION=
WHATSAPP_DOWNLOAD_INCOMING_DOCUMENTS=true
WHATSAPP_SEND_WAIT_TIMEOUT_MS=60000

WHATSAPP_OUTGOING_QUEUE=WhatsComs
